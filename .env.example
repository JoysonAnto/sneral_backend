# ==============================================================================
# SNEARAL UNIFIED BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SERVER (Core)
# ------------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:1234@localhost:5432/snearal?schema=public"

# Server Port and Environment
PORT=3000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Frontend Client URL (used for payment redirect return URLs)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret keys for signing access and refresh tokens
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production

# Token expiration durations (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CACHING & QUEUES (Redis)
# ------------------------------------------------------------------------------
# Set to false to disable Redis in local development
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional full connection URL (takes precedence if provided):
# REDIS_URL=redis://:password@localhost:6379

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Elastic Email API)
# ------------------------------------------------------------------------------
# Elastic Email HTTP API Key (used for OTP, email verification, notifications)
ELASTIC_EMAIL_API_KEY=
EMAIL_FROM=noreply@snearal.com

# ------------------------------------------------------------------------------
# 5. GEOLOCATION & MAPS (Google Maps API)
# ------------------------------------------------------------------------------
# Required for geocoding customer addresses, distance matrix, and partner matching radius
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 6. CLOUD MEDIA STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Required for uploading category icons, service catalog images, before/after service photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Razorpay Credentials (used for booking payments and wallet top-ups)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Credentials (used for KYC verification suite & Cashfree PG orders)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox # "sandbox" or "production"

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATIONS (Firebase Admin SDK / FCM v1)
# ------------------------------------------------------------------------------
# Option A: Full service account JSON as a single-line string (Recommended)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option B: Individual credentials from Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 9. MONITORING & APM (Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 10. DEFAULT ADMIN CREDENTIALS (for initial seeding)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@snearal.com
ADMIN_PASSWORD=password123
