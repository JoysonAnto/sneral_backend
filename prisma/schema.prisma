model PlatformSettings {
  id               String   @id @default(uuid())
  key              String   @unique
  value            String
  description      String?
  updated_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("platform_settings")
}

model Review {
  id          String     @id @default(uuid())
  booking_id  String
  reviewer_id String
  reviewee_id String
  rating      Int
  comment     String?
  type        ReviewType
  created_at  DateTime   @default(now())
  booking     Booking    @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  reviewer    User       @relation("ReviewGiver", fields: [reviewer_id], references: [id])
  reviewee    User       @relation("ReviewReceiver", fields: [reviewee_id], references: [id])

  @@unique([booking_id, type])
  @@index([reviewee_id])
  @@index([reviewer_id])
  @@map("reviews")
}

enum ReviewType {
  CUSTOMER_TO_PARTNER
  PARTNER_TO_CUSTOMER
}

model Ticket {
  id               String         @id @default(uuid())
  ticket_number    String         @unique
  subject          String
  description      String
  category         String         @default("GENERAL")
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  customer_name    String?
  customer_email   String?
  customer_phone   String?
  user_id          String?
  booking_id       String?
  partner_id       String?
  assigned_to      String?
  resolution_notes String?
  resolved_at      DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  user             User?          @relation(fields: [user_id], references: [id])

  @@index([status])
  @@index([priority])
  @@index([user_id])
  @@map("tickets")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum CouponRedemptionStatus {
  PENDING
  REDEEMED
  FAILED
  CANCELLED
}

model Coupon {
  id                   String              @id @default(uuid())
  code                 String              @unique
  name                 String
  description          String?
  discount_type        DiscountType        @default(FIXED)
  discount_value       Float
  max_discount         Float?
  min_order_amount     Float               @default(0)
  start_date           DateTime
  expiry_date          DateTime
  total_usage_limit    Int?
  per_user_usage_limit Int                 @default(1)
  new_user_only        Boolean             @default(false)
  applicable_services  String[]            @default([])
  terms_conditions     String?
  is_active            Boolean             @default(true)
  used_count           Int                 @default(0)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  bookings             Booking[]
  redemptions          CouponRedemption[]

  @@index([code])
  @@index([is_active])
  @@index([expiry_date])
  @@map("coupons")
}

model CouponRedemption {
  id              String                 @id @default(uuid())
  coupon_id       String
  user_id         String
  booking_id      String?
  discount_amount Float
  order_amount    Float
  status          CouponRedemptionStatus @default(PENDING)
  redeemed_at     DateTime?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  coupon          Coupon                 @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  booking         Booking?               @relation(fields: [booking_id], references: [id], onDelete: SetNull)

  @@index([coupon_id])
  @@index([user_id])
  @@index([booking_id])
  @@index([status])
  @@map("coupon_redemptions")
}

// ============================================
// SURGE & HIGH DEMAND ZONES
// ============================================
model SurgeArea {
  id               String    @id @default(uuid())
  name             String
  city             String
  latitude         Float
  longitude        Float
  radius_km        Float     @default(5)
  surge_multiplier Float     @default(1.3)
  bonus_per_order  Float     @default(50)
  is_active        Boolean   @default(true)
  starts_at        DateTime?
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([city])
  @@index([is_active])
  @@map("surge_areas")
}

// ============================================
// PARTNER MILESTONE REWARDS
// ============================================
enum RewardCycle {
  DAILY
  WEEKLY
}

enum RewardType {
  WALLET_MONEY
  REWARD_POINTS
}

model PartnerRewardRule {
  id             String               @id @default(uuid())
  title          String
  target_jobs    Int?
  target_hours   Float?
  condition_type String               @default("OR") // "OR" or "AND"
  reward_type    RewardType           @default(WALLET_MONEY)
  reward_amount  Float
  cycle          RewardCycle          @default(DAILY)
  is_active      Boolean              @default(true)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  claims         PartnerRewardClaim[]

  @@map("partner_reward_rules")
}

model PartnerRewardClaim {
  id                       String            @id @default(uuid())
  partner_id               String
  rule_id                  String
  cycle_date               String            // "YYYY-MM-DD"
  reward_amount            Float
  transaction_id           String?
  completed_jobs_at_claim  Int
  completed_hours_at_claim Float
  created_at               DateTime          @default(now())

  partner                  ServicePartner    @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  rule                     PartnerRewardRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@unique([partner_id, rule_id, cycle_date])
  @@index([partner_id])
  @@index([cycle_date])
  @@map("partner_reward_claims")
}

// ============================================
// DUAL REFERRAL PROGRAM (CUSTOMER & PARTNER)
// ============================================
enum ReferralType {
  CUSTOMER_TO_CUSTOMER
  PARTNER_TO_PARTNER
  PARTNER_TO_CUSTOMER
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
}

model ReferralTracking {
  id                   String         @id @default(uuid())
  referrer_user_id     String
  referee_user_id      String
  referral_type        ReferralType   @default(CUSTOMER_TO_CUSTOMER)
  referral_code        String
  status               ReferralStatus @default(PENDING)
  referrer_reward      Float          @default(100)
  referee_reward       Float          @default(100)
  qualification_target Int            @default(1) // 1 job for customer, 5 jobs for partner
  qualifying_count     Int            @default(0)
  rewarded_at          DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  referrer             User           @relation("ReferrerUser", fields: [referrer_user_id], references: [id], onDelete: Cascade)
  referee              User           @relation("RefereeUser", fields: [referee_user_id], references: [id], onDelete: Cascade)

  @@unique([referrer_user_id, referee_user_id, referral_type])
  @@index([referral_code])
  @@index([status])
  @@map("referral_trackings")
}

model ReferralConfig {
  id                       String   @id @default(uuid())
  customer_referrer_reward Float    @default(100)
  customer_referee_reward  Float    @default(100)
  partner_referrer_reward  Float    @default(1000)
  partner_qualifying_jobs  Int      @default(5)
  partner_referee_reward   Float    @default(500)
  is_active                Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@map("referral_configs")
}


